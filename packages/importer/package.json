    "import": "node --experimental-strip-types src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "unpdf": "^1.8.0"
  }
}
