{
  "name": "@kviz/importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Regenerates the question data from the official PDF",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
